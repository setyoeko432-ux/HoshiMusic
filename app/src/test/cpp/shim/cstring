// Shim <cstring> untuk harness freestanding.
#pragma once

#include <stddef.h>
#include <stdint.h>
#include "hosi_rt.h"

namespace std {
inline void* memset(void* dst, int c, size_t n) { return hosi_rt_memset(dst, c, n); }
inline void* memcpy(void* dst, const void* src, size_t n) { return hosi_rt_memcpy(dst, src, n); }
inline char* strcpy(char* dst, const char* src) { return hosi_rt_strcpy(dst, src); }
inline int memcmp(const void* a, const void* b, size_t n) {
    const unsigned char* x = (const unsigned char*)a;
    const unsigned char* y = (const unsigned char*)b;
    for (size_t i = 0; i < n; ++i) if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1;
    return 0;
}
} // namespace std

static inline void* memset(void* dst, int c, size_t n) { return hosi_rt_memset(dst, c, n); }
static inline void* memcpy(void* dst, const void* src, size_t n) { return hosi_rt_memcpy(dst, src, n); }
static inline char* strcpy(char* dst, const char* src) { return hosi_rt_strcpy(dst, src); }